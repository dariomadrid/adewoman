---
// Custom loading page that redirects to Catalan version
---

<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ADEWOMAN FISIOTERÀPIA</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="robots" content="noindex">
  <link rel="canonical" href="/ca/">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      background: linear-gradient(135deg, #1f2937 0%, #374151 100%);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color: white;
      overflow: hidden;
    }
    
    .loading-container {
      text-align: center;
      animation: fadeIn 0.3s ease-in;
    }
    
    .brand {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      letter-spacing: 2px;
    }
    
    .subtitle {
      font-size: 1.2rem;
      font-weight: 300;
      opacity: 0.8;
      margin-bottom: 2rem;
      letter-spacing: 1px;
    }
    
    .loading-text {
      font-size: 1.1rem;
      font-weight: 500;
      margin-bottom: 1.5rem;
      opacity: 0.9;
    }
    
    .spinner {
      border: 3px solid rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      border-top: 3px solid #ffffff;
      width: 50px;
      height: 50px;
      animation: spin 1s linear infinite;
      margin: 0 auto;
    }
    
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <div class="loading-container">
    <div class="brand">AW</div>
    <div class="subtitle">FISIOTERÀPIA</div>
    <div class="loading-text">Carregant...</div>
    <div class="spinner"></div>
  </div>
  
  <script>
    // Redirect immediately to prevent any default messages
    setTimeout(() => {
      window.location.replace('/ca/');
    }, 800);
  </script>
</body>
</html>